	for (int LFVIndex = 0; LFVIndex < OutLFVCount; ++LFVIndex)
	{
		uint InstanceIndex = OpaqueBasePass_Shared_LFV_LocalFogVolumeTileDataTexture[uint3(TilePos, 1 + LFVIndex)];

